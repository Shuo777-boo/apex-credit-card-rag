# Copy to .env. Never commit .env; backend only. Percent-encode special DSN password characters.
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=apex
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Manual Conda backend uses localhost; Compose explicitly overrides host to postgres.
APEX_DATABASE_URL=postgresql://apex:change-me-local-only@localhost:5432/apex
DASHSCOPE_API_KEY=
APEX_MODEL_REGION=beijing
# Optional new workspace routing; uncomment and fill only when required by your account.
# APEX_WORKSPACE_ID=your-workspace-id
APEX_EMBEDDING_MODEL=text-embedding-v4
APEX_EMBEDDING_DIMENSION=1024
APEX_RERANK_MODEL=qwen3-rerank
APEX_LLM_MODEL=qwen3.5-plus
APEX_API_TIMEOUT_SECONDS=60
APEX_API_MAX_RETRIES=2
APEX_API_MAX_REQUESTS=1500
APEX_POOL_MIN_SIZE=1
APEX_POOL_MAX_SIZE=10
APEX_CANDIDATE_DEPTH=20
APEX_RERANK_DEPTH=20
APEX_RRF_K=60
APEX_CORS_ORIGINS=["http://localhost:5173"]
APEX_DATA_DIR=data
APEX_REPORTS_DIR=reports
